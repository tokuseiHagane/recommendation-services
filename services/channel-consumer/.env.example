# ============================================
# Social Channel Consumer - Configuration
# ============================================
# Copy this file to .env and fill in your values

# ============================================
# MODULE TOGGLES (Distributed Monolith)
# ============================================
# Enable/disable modules independently
ENABLE_TG_MODULE=true
ENABLE_VK_MODULE=true

# ============================================
# TELEGRAM DATABASE (PostgreSQL)
# ============================================
# Used for Telegram channels data
TG_DB_HOST=localhost
TG_DB_PORT=5432
TG_DB_USER=postgres
TG_DB_PASSWORD=postgres
TG_DB_NAME=telegram

# Legacy aliases (for backward compatibility)
# DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME also work

# ============================================
# VK DATABASE (PostgreSQL)
# ============================================
# Used for VK groups data (SEPARATE database)
VK_DB_HOST=localhost
VK_DB_PORT=5432
VK_DB_USER=postgres
VK_DB_PASSWORD=postgres
VK_DB_NAME=vk

# ============================================
# KAFKA CONFIGURATION
# ============================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Telegram Kafka settings
TG_KAFKA_TOPIC=tg_channels
TG_KAFKA_GROUP_ID=tg-channel-consumer

# VK Kafka settings
VK_KAFKA_TOPIC=vk_groups
VK_KAFKA_GROUP_ID=vk-group-consumer

# ============================================
# BATCH PROCESSING
# ============================================
BATCH_SIZE=100
BATCH_TIMEOUT=5.0

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO

# ============================================
# APPLICATION
# ============================================
ENV=development
DEBUG=false
