# Environment Configuration для Social Posts Consumer (Telegram & VK)
# Скопируйте этот файл в .env и настройте под свои нужды

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
ENV=development
DEBUG=false
LOG_LEVEL=INFO

# ============================================================================
# TELEGRAM DATABASE SETTINGS (PostgreSQL)
# ============================================================================
DB_HOST=tg-channel-db
DB_PORT=5432
DB_USER=app_user
DB_PASSWORD=app_password
DB_NAME=telegram

# ============================================================================
# VK DATABASE SETTINGS (PostgreSQL)
# ============================================================================
VK_DB_HOST=vk-group-db
VK_DB_PORT=5432
VK_DB_USER=app_user
VK_DB_PASSWORD=app_password
VK_DB_NAME=vk

# ============================================================================
# KAFKA SETTINGS (общие)
# ============================================================================
# Bootstrap servers (для подключения к Kafka кластеру)
KAFKA_BOOTSTRAP_SERVERS=broker:29092

# ============================================================================
# TELEGRAM KAFKA SETTINGS
# ============================================================================
# Group ID prefix для consumer groups
KAFKA_GROUP_ID_PREFIX=posts-consumer-group

# Kafka Topics
KAFKA_CHANNELS_DIFF_TOPIC=tg_channels_diff
KAFKA_POSTS_TOPIC_PREFIX=tg_posts_

# ============================================================================
# VK KAFKA SETTINGS
# ============================================================================
# Group ID prefix для VK consumer groups
# KAFKA_GROUP_ID_PREFIX=vk-posts-consumer-group  # Устанавливается в docker-compose

# Kafka Topics
KAFKA_GROUPS_DIFF_TOPIC=vk_groups_diff
# KAFKA_POSTS_TOPIC_PREFIX=vk_posts_  # Устанавливается в docker-compose

# ============================================================================
# PROCESSING SETTINGS (общие для обоих сервисов)
# ============================================================================
# Batch Processing
BATCH_SIZE=100
BATCH_TIMEOUT_MS=10000

# Cache
CACHE_TTL_SECONDS=300

# Consumer
CONSUMER_TIMEOUT_MS=1000
AUTO_OFFSET_RESET=earliest

# ============================================================================
# DOCKER SETTINGS (для docker-compose)
# ============================================================================
# Volumes
DATA_DIR=./data
SPECS_DIR=./specs
