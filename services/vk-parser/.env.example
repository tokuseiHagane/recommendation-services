# Application Settings
APP_NAME=vk-parser-service
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# API Configuration
API_VERSION=v1
SERVICE_NAME=vk

# Database (legacy compatibility fallback)
# Используется только если AUTH_ENABLE_LEGACY_DB_FALLBACK=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/porto_db

# Redis (для кеширования)
REDIS_URL=redis://localhost:6379/0
REDIS_DEFAULT_TTL=86400

# Legacy JWT settings (deprecated, kept for transition docs only)
JWT_SECRET_KEY=your-jwt-secret-key-same-as-auth-service
JWT_ALGORITHM=HS256

# AuthService integration
AUTH_SERVICE_URL=http://auth-service:3000
AUTH_JWKS_URL=http://auth-service:3000/api/auth/jwks
AUTH_JWT_ISSUER=fdauth-service
AUTH_JWT_ALGORITHMS=["RS256"]
AUTH_JWT_LEEWAY_SECONDS=30
AUTH_JWKS_CACHE_TTL_SECONDS=300
AUTH_VK_TOKEN_ENDPOINT=/api/internal/auth/vk-account
AUTH_BACKEND_SHARED_SECRET=change-me-in-prod
AUTH_HTTP_TIMEOUT_SECONDS=5.0

# Temporary compatibility mode during rollout
AUTH_ENABLE_LEGACY_COOKIE_FALLBACK=false
AUTH_ENABLE_LEGACY_DB_FALLBACK=false

# VK API (опционально, fallback для тестирования)
VK_ACCESS_TOKEN=

# Logfire (optional)
LOGFIRE_TOKEN=
LOGFIRE_PROJECT_NAME=vk-parser-service
LOGFIRE_ENVIRONMENT=development
LOGFIRE_LOG_LEVEL=DEBUG
LOGFIRE_SAMPLE_RATE=1.0

# Kafka (Message Broker)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUPS_TOPIC=vk_groups
KAFKA_POSTS_TOPIC_PREFIX=vk_posts_

# CORS
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]
